    <panel_attributes>title=SD-13: Run a Feature from the CLI
obj=Job Seeker (CLI)~User
obj=CLIApp~CLI
obj=CommandInvoker~CI
obj=GenerateCoverLetterCommand~GCC
obj=AIFeatureController~AC

User-&gt;CLI : main(["cover-letter", "--app", "42", "--tone", "formal"])
CLI-&gt;CLI : parse(args)
iframe{:break [unknown command or missing arguments]
CLI.&gt;User : usage message
iframe}
CLI-&gt;GCC : create(applicationId, tone)
CLI-&gt;CI : execute(command)
CI-&gt;CI : add command to history
CI-&gt;GCC : execute()
GCC-&gt;AC : generateCoverLetter(applicationId, tone)
iframe{:Note (AC) the controller continues exactly as in SD-04 (facade, prompt factory, Gemini, save)
iframe}
iframe{:alt [generation succeeds]
AC.&gt;GCC : CoverLetter
GCC.&gt;CI : CommandResult(success = true, output = letter text)
--[a flow of SD-04 fails (3a, 4a, 5a)]
AC.&gt;GCC : error
GCC.&gt;CI : CommandResult(success = false, output = error message)
iframe}
CI.&gt;CLI : CommandResult
