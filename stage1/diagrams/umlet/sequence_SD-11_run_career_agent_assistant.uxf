<diagram program="umlet" version="14.3.0">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>20</x>
      <y>20</y>
      <w>2310</w>
      <h>2294</h>
    </coordinates>
    <panel_attributes>title=SD-11: Run Career Agent Assistant
obj=Job Seeker~Seeker
obj=KanbanDashboardUI~UI
obj=AgentController~AC
obj=MemoryManager~MM
obj=MemoryRepository~MR
obj=Planner~PL
obj=ToolManager~TM
obj=AIEngineFacade~AF
obj=PlanningPromptFactory~PPF
obj=GeminiClient~GC
obj=Gemini API~G
obj=ResponseValidator~RV
obj=JSONResponseParser~JP
obj=Plan~PN
obj=Tool (e.g. MatchAnalysisTool)~T

Seeker-&gt;UI : "Get me ready for the Shopify job"
UI-&gt;AC : handleRequest(userId, message)
AC-&gt;MM : recall(userId, message)
MM-&gt;MR : findByUser(userId)
MR.&gt;MM : List[MemoryEntry]
MM.&gt;AC : relevant MemoryEntries
AC-&gt;PL : createPlan(message, context)
PL-&gt;TM : getAvailableTools()
TM.&gt;PL : List[ToolInfo]
PL-&gt;AF : planSteps(request, tools)
AF-&gt;PPF : createPrompt(context)
PPF.&gt;AF : PlanningPrompt
AF-&gt;GC : generate(prompt)
GC-&gt;G : generateContent(jsonBody)
G.&gt;GC : JSON plan
GC.&gt;AF : LLMResponse
AF-&gt;RV : validateLLMOutput(rawText, planSchema)
RV.&gt;AF : ValidationResult
combinedFragment=opt~f1 Seeker,T
Seeker:[plan is invalid (4a)]
PL-&gt;AF : planSteps(request, tools) replan once
AF.&gt;PL : second attempt
combinedFragment=break~f2 Seeker,T
Seeker:[still invalid]
PL.&gt;AC : planning failed
AC.&gt;UI : AgentResponse (could not plan this request)
UI.&gt;Seeker : explanation
--=f2
--=f1
AF-&gt;JP : parsePlan(json)
JP.&gt;AF : Plan
AF.&gt;PL : Plan
PL.&gt;AC : Plan
AC-&gt;PN : needsClarification()
combinedFragment=break~f3 Seeker,T
Seeker:[request is ambiguous, no job can be identified (2a)]
AC.&gt;UI : AgentResponse (clarifying question)
UI.&gt;Seeker : asks which job
--=f3
AC-&gt;AC + : executePlan(plan)
combinedFragment=loop~f4 Seeker,T
Seeker:[until plan.isComplete()]
AC-&gt;PN : nextStep()
PN.&gt;AC : PlanStep(toolName, arguments)
AC-&gt;RV : validateToolArgs(tool, args)
RV.&gt;AC : ValidationResult
combinedFragment=opt~f5 Seeker,T
Seeker:[arguments fail validation (5a)]
AC-&gt;PL : replan(plan, step)
PL.&gt;AC : revised Plan
combinedFragment=break~f6 Seeker,T
Seeker:[arguments still invalid]
AC.&gt;UI : AgentResponse (asks for the missing information)
UI.&gt;Seeker : asks for missing details
--=f6
--=f5
AC-&gt;TM : executeTool(name, args)
TM-&gt;T : execute(args)
T:Note: the tool calls AIEngineFacade and follows SD-03, SD-04 or SD-07
T.&gt;TM : ToolResult
TM.&gt;AC : ToolResult
combinedFragment=opt~f7 Seeker,T
Seeker:[ToolResult.success is false (5b)]
AC-&gt;PL : replan(plan, failedStep)
PL.&gt;AC : revised Plan
combinedFragment=break~f8 Seeker,T
Seeker:[agent cannot recover]
AC-&gt;MM : saveInteraction(userId, entry)
AC.&gt;UI : AgentResponse (completed steps, failed steps, no invented results)
UI.&gt;Seeker : report of what was done and what failed
--=f8
--=f7
AC-&gt;AC + : store ToolResult in PlanStep
--=f4
AC-&gt;MM : saveInteraction(userId, entry)
MM-&gt;MR : save(userId, entry)
AC.&gt;UI : AgentResponse (summary of results)
UI.&gt;Seeker : display summary</panel_attributes>
    <additional_attributes />
  </element>
</diagram>