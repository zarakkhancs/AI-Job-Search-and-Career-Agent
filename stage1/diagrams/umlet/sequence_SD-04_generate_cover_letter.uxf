    <panel_attributes>title=SD-04: Generate Cover Letter
obj=Job Seeker~Seeker
obj=KanbanDashboardUI~UI
obj=AIFeatureController~AC
obj=JobApplicationRepository~JR
obj=ResumeRepository~RR
obj=AIEngineFacade~AF
obj=CoverLetterPromptFactory~CPF
obj=GeminiClient~GC
obj=Gemini API~G
obj=ResponseValidator~RV
obj=JSONResponseParser~JP

Seeker-&gt;UI : click "Generate Cover Letter" (optional tone)
UI-&gt;AC : generateCoverLetter(applicationId, tone)
AC-&gt;JR : findById(applicationId)
JR.&gt;AC : JobApplication (with JobPosting)
AC-&gt;RR : findByUser(userId)
RR.&gt;AC : Resume
iframe{:break [no resume uploaded (3a)]
AC.&gt;UI : error
UI.&gt;Seeker : prompt to import a resume first (UC-01)
iframe}
AC-&gt;AF : generateCoverLetter(resume, job, tone)
AF-&gt;CPF : createPrompt(context)
CPF.&gt;AF : CoverLetterPrompt
AF-&gt;GC : generate(prompt)
GC-&gt;G : generateContent(jsonBody)
iframe{:break [Gemini times out or fails (4a)]
G.&gt;GC : error or timeout
GC.&gt;AF : LLMException
AF.&gt;AC : AIServiceException (logged)
AC.&gt;UI : error
UI.&gt;Seeker : "Service Unavailable - Please Retry" (nothing saved)
iframe}
G.&gt;GC : JSON text
GC.&gt;AF : LLMResponse
AF-&gt;RV : validateLLMOutput(rawText, schema)
RV.&gt;AF : ValidationResult
iframe{:opt [response is malformed (5a)]
AF-&gt;GC : generate(prompt) retry once
GC.&gt;AF : LLMResponse
AF-&gt;RV : validateLLMOutput(rawText, schema)
RV.&gt;AF : ValidationResult
iframe{:break [still invalid, continue as 4a]
AF.&gt;AC : AIServiceException
AC.&gt;UI : error
UI.&gt;Seeker : "Service Unavailable - Please Retry"
iframe}
iframe}
AF-&gt;JP : parseCoverLetter(json)
JP.&gt;AF : CoverLetter
AF.&gt;AC : CoverLetter
AC-&gt;JR : save(application with CoverLetter)
AC.&gt;UI : CoverLetter
UI.&gt;Seeker : show letter in editable view</panel_attributes>
